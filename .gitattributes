# Normalize line endings to LF in the repository; Git checks files out using
# the platform's native line ending unless core.autocrlf=input is set.
* text=auto eol=lf

*.java text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.css text eol=lf
*.csv text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf

# Binary assets: never touch line endings, never diff as text.
*.png binary
*.jpg binary
*.jpeg binary
*.mp3 binary
*.ttf binary
*.pdf binary
